{
  "name": "nexus-app",
  "private": true,
  "version": "1.0.0",
  "description": "Nexus App - Social Gaming, Synchronized Music Lounge & Voice Mesh Platform",
  "type": "module",
  "scripts": {
    "start": "npm run build && node server.cjs",
    "start:server": "node server.cjs",
    "test": "node test_full_suite.cjs",
    "verify": "npm run lint && npm run build && node --check server.cjs",
    "dev": "node scripts/dev.cjs",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.22.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "16.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.26.1",
    "vite": "6.3.1"
  }
}
