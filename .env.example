# Nexus App Environment Configuration
# Copy this file to .env and adjust variables as needed

# Server listening port (default: 3000)
PORT=3000

# Server host interface (0.0.0.0 to allow LAN and external access)
HOST=0.0.0.0

# Environment mode (development / production)
NODE_ENV=production

# Optional custom secret for session tokens
# SESSION_SECRET=your_super_secret_session_key_here
